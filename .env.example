# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Docker Compose auto-loads .env next to the compose file.
# Never commit .env — it is gitignored.

# Gitea OAuth app for Drone (create in Gitea → Settings → Applications)
DRONE_GITEA_CLIENT_ID=
DRONE_GITEA_CLIENT_SECRET=

# Shared secret between Drone server and runner (any long random string)
DRONE_RPC_SECRET=

# Pi-hole admin UI password
WEBPASSWORD=
